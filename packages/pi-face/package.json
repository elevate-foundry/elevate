{
  "name": "pi-face",
  "version": "0.1.0",
  "description": "A frontend-neutral visual presence for AI agents, with a Pi terminal adapter.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "terminal",
    "cat",
    "agent-ui",
    "canvas",
    "particles",
    "multi-agent",
    "langgraph",
    "tool-algebra",
    "visualization",
    "ambient-ui"
  ],
  "files": [
    "extensions/",
    "src/",
    "demo/",
    "docs/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/face.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@earendil-works/pi-tui": "0.99.1",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "demo:build": "node scripts/build-demo.mjs",
    "demo:serve": "npm run demo:build && python3 -m http.server 4173 --directory demo",
    "demo:stream": "node scripts/langgraph-stream-demo.mjs",
    "check": "npm run typecheck && npm run demo:build && npm test",
    "prepublishOnly": "npm run check"
  }
}
